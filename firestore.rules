rules_version = '2';

// Foundation rules: deny everything until real role-based rules are designed.
// Do not open these rules to make the admin UI work. Client-side checks are
// only a user-experience safeguard; server rules are the actual security layer.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
